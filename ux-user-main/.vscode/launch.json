{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Vite (Chrome)",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/src/*",
        "/src/*": "${webRoot}/src/*",
        "/@fs/*": "/*"
      }
    }
  ]
}