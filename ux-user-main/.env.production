# 页面标题
VITE_GLOB_APP_TITLE = AI智算
# 开发环境配置
VITE_APP_ENV = 'development'
# 公共基础路径
VITE_PUBLIC_PATH = /
# 开发环境接口地址
VITE_APP_BASE_API = '/api'
# 代理地址
VITE_PROXY_URL = 'https://ai.api.lingyangtech.com'
# 打包时是否删除 console
VITE_DROP_CONSOLE = true
# 是否启用 gzip 或 brotli 压缩打包，如果需要多个压缩规则，可以使用 “,” 分隔
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = 'none'
# LOGO 
VITE_GLOB_APP_LOGO = 'logo'
# favicon
VITE_GLOB_APP_ICO = 'AI'



