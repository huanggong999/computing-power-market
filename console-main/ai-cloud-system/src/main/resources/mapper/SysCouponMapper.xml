<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lingyang.cloud.mapper.SysCouponMapper">


    <select id="getCoupons" resultType="com.lingyang.cloud.model.dto.SysActiveCouponDTO">
        SELECT
            id,
            `name`,
            deduction_amount,
            type,
            range_type,
            receive_num,
            count,
            use_time_start,
            use_time_end,
            status
        FROM
            sys_coupon
        WHERE
        del_flag = 0
        <if test="param.couponType != null">
            AND type = #{param.couponType}
        </if>
        <if test="param.couponName != null and param.couponName != ''">
            AND `name` LIKE concat('%',#{param.couponName},'%')
        </if>
        <if test="param.startDate != null">
            AND use_time_start &gt;= #{param.startDate}
        </if>
        <if test="param.endDate != null">
            AND use_time_end &lt;= #{param.endDate}
        </if>
        ORDER BY id
    </select>
</mapper>