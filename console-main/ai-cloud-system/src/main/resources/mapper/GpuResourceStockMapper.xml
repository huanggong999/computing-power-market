<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lingyang.cloud.mapper.GpuResourceStockMapper">

    <select id="selectByResourceId" resultType="com.lingyang.cloud.entity.GpuResourceStockEntity">
        SELECT *
        FROM gpu_resource_stock
        WHERE resource_id = #{resourceId}
        AND del_flag = 0
    </select>

</mapper>
