<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lingyang.cloud.mapper.SysCustomerVoucherMapper">

    <update id="returnVoucherAmount">
        <foreach collection="list" separator=";" item="entity" >
            update sys_customer_voucher
            set use_amount = use_amount - #{entity.useAmount}
            where id = #{entity.id}
        </foreach>
    </update>
</mapper>