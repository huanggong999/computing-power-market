<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lingyang.cloud.mapper.GpuResourceMapper">

    <select id="selectGpuMarketList" resultType="com.lingyang.cloud.entity.GpuResourceEntity">
        SELECT gr.*
        FROM gpu_resource gr
        LEFT JOIN gpu_resource_spec gs ON gr.spec_id = gs.id AND gs.del_flag = 0
        JOIN gpu_resource_price gp ON gr.id = gp.resource_id AND gp.del_flag = 0
        <choose>
            <when test="query.billingType != null and query.billingType != ''">
                AND gp.billing_type = #{query.billingType}
            </when>
            <otherwise>
                AND gp.billing_type = 'hourly'
            </otherwise>
        </choose>
        WHERE gr.del_flag = 0
        <if test="query.status != null">
            AND gr.status = #{query.status}
        </if>
        <if test="query.regionCode != null and query.regionCode != ''">
            AND gr.region_code = #{query.regionCode}
        </if>
        <if test="query.excludedRegionCodes != null and query.excludedRegionCodes.size() > 0">
            AND LOWER(gr.region_code) NOT IN
            <foreach collection="query.excludedRegionCodes" item="regionCode" open="(" separator="," close=")">
                LOWER(#{regionCode})
            </foreach>
        </if>
        <if test="query.zoneCode != null and query.zoneCode != ''">
            AND gr.zone_code = #{query.zoneCode}
        </if>
        <if test="query.gpuCount != null">
            AND gr.gpu_count = #{query.gpuCount}
        </if>
        <if test="query.gpuModels != null and query.gpuModels.size() > 0">
            AND gs.model IN
            <foreach collection="query.gpuModels" item="model" open="(" separator="," close=")">
                #{model}
            </foreach>
        </if>
        <choose>
            <when test="query.sortBy == 'price' and query.sortOrder == 'asc'">
                ORDER BY gp.unit_price ASC
            </when>
            <when test="query.sortBy == 'price' and query.sortOrder == 'desc'">
                ORDER BY gp.unit_price DESC
            </when>
            <when test="query.sortBy == 'vram' and query.sortOrder == 'asc'">
                ORDER BY gs.sort_order ASC
            </when>
            <when test="query.sortBy == 'vram' and query.sortOrder == 'desc'">
                ORDER BY gs.sort_order DESC
            </when>
            <when test="query.sortBy == 'model' and query.sortOrder == 'asc'">
                ORDER BY gs.model ASC
            </when>
            <when test="query.sortBy == 'model' and query.sortOrder == 'desc'">
                ORDER BY gs.model DESC
            </when>
            <otherwise>
                ORDER BY gr.create_time DESC
            </otherwise>
        </choose>
    </select>

    <select id="countGpuMarketList" resultType="java.lang.Long">
        SELECT COUNT(DISTINCT gr.id)
        FROM gpu_resource gr
        LEFT JOIN gpu_resource_spec gs ON gr.spec_id = gs.id AND gs.del_flag = 0
        JOIN gpu_resource_price gp ON gr.id = gp.resource_id AND gp.del_flag = 0
        WHERE gr.del_flag = 0
        <if test="query.status != null">
            AND gr.status = #{query.status}
        </if>
        <if test="query.regionCode != null and query.regionCode != ''">
            AND gr.region_code = #{query.regionCode}
        </if>
        <if test="query.excludedRegionCodes != null and query.excludedRegionCodes.size() > 0">
            AND LOWER(gr.region_code) NOT IN
            <foreach collection="query.excludedRegionCodes" item="regionCode" open="(" separator="," close=")">
                LOWER(#{regionCode})
            </foreach>
        </if>
        <if test="query.zoneCode != null and query.zoneCode != ''">
            AND gr.zone_code = #{query.zoneCode}
        </if>
        <if test="query.gpuCount != null">
            AND gr.gpu_count = #{query.gpuCount}
        </if>
        <if test="query.gpuModels != null and query.gpuModels.size() > 0">
            AND gs.model IN
            <foreach collection="query.gpuModels" item="model" open="(" separator="," close=")">
                #{model}
            </foreach>
        </if>
        <choose>
            <when test="query.billingType != null and query.billingType != ''">
                AND gp.billing_type = #{query.billingType}
            </when>
            <otherwise>
                AND gp.billing_type = 'hourly'
            </otherwise>
        </choose>
    </select>

</mapper>
