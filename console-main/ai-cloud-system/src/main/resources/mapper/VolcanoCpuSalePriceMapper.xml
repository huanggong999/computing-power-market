<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingyang.cloud.mapper.VolcanoCpuSalePriceMapper">
 <select id="selectByUniqueKey" resultType="com.lingyang.cloud.entity.VolcanoCpuSalePriceEntity">
  SELECT * FROM volcano_cpu_sale_price WHERE region_code=#{regionCode} AND instance_type_id=#{instanceTypeId} AND billing_type=#{billingType} AND del_flag=0 LIMIT 1
 </select>
 <delete id="deletePhysicalById">DELETE FROM volcano_cpu_sale_price WHERE id=#{id}</delete>
</mapper>
